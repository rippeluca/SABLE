    sable:span "The fact that we did not detect a strong effect of soil variables on species distributions may be due to the spatial resolution of our analysis; we cannot exclude that at a finer scale, soil characteris-tics could be an important driver of local distribution within areas that are otherwise climatically suitable (Thuiller, 2013)." .

<https://github.com/Acul01/SABLE/id/c061/evidence> a sable:Evidence ;
    dcterms:source <https://doi.org/10.1002/ecs2.2987> ;
    cito:supports id:c061 ;
    sable:evidenceFor id:c061 ;
    sable:span "Our results indicate thatP. juliflora invasion in Eastern Africa is still at anearly stage and that it is likely to expand its cur-rent geographic range significantly if left uncon-trolled." .

<https://github.com/Acul01/SABLE/id/c062/evidence> a sable:Evidence ;
    dcterms:source <https://doi.org/10.1002/ecs2.2987> ;
    cito:supports id:c062 ;
    sable:evidenceFor id:c062 ;
    sable:span "L. camara, by contrast, appears to beapproaching a pseudo-stable equilibrium in East-ern Africa." .

<https://github.com/Acul01/SABLE/id/c063/evidence> a sable:Evidence ;
    dcterms:source <https://doi.org/10.3390/f9030117> ;
    cito:supports id:c063 ;
    sable:evidenceFor id:c063 ;
    sable:span "We found that pine plantations and their subsequent invasion in the Patagonian shrubby steppeproduced sharp changes in fine fuel amount and its vertical and horizontal continuity." .

<https://github.com/Acul01/SABLE/id/c064/evidence> a sable:Evidence ;
    dcterms:source <https://doi.org/10.3390/f9030117> ;
    cito:disputes id:c064 ;
    sable:evidenceFor id:c064 ;
    sable:span "There were no significant differences in the amount of fine fuels across the vertical distribution andthe horizontal continuity between low and intermediate invasions (Figure 3e,f)." .

<https://github.com/Acul01/SABLE/id/c065/evidence> a sable:Evidence ;
    dcterms:source <https://doi.org/10.1111/1365-2664.14287> ;
    cito:disputes id:c065 ;
    sable:evidenceFor id:c065 ;
    sable:span "Species introduced by means of release (120, 16– 1900), escape (160, 36– 850), as contam-inants (120, 24– 800) or as stowaways (240, 32– 1900) did not differ in their area of occupancy (all estimates in km2; all |t| < 4, p > 0.002)." .

<https://github.com/Acul01/SABLE/id/c066/evidence> a sable:Evidence ;
    dcterms:source <https://doi.org/10.3390/su13147541> ;
    cito:supports id:c066 ;
    sable:evidenceFor id:c066 ;
    sable:span "The results showed that activerestoration of the first approach is feasible in the medium-term (3 years after plantationsreaching survival rates >30–40% in average)." .

<https://github.com/Acul01/SABLE/id/c067/evidence> a sable:Evidence ;
    dcterms:source <https://doi.org/10.3390/su13147541> ;
    sable:evidenceFor id:c067 ;
    sable:span "However, the variation in beaver meadowsgreatly affected the performance and effectiveness of the planting and understory removal,e." .

sable:acceptedLabel a rdf:Property ;
    rdfs:label "label kept by the one-round check" .

sable:agreement a rdf:Property ;
    rdfs:label "share of five replies with the majority label" ;
    rdfs:comment "Share of the five replies that emitted the majority label." .

sable:checkedBy a rdf:Property ;
    rdfs:label "one-round run" .

sable:decision a rdf:Property ;
    rdfs:label "one-round decision" .

sable:evidenceFor a rdf:Property ;
    rdfs:label "evidence for" .

sable:evidenceInTopFive a rdf:Property ;
    rdfs:label "span was in the five chunks" .

sable:goldLabel a rdf:Property ;
    rdfs:label "human label" .

sable:labelAfterDeletion a rdf:Property ;
    rdfs:label "temperature-0 label after the span was deleted" .

sable:labelChanged a rdf:Property ;
    rdfs:label "deleting the span changed the temperature-0 label" ;
    rdfs:comment "Present only where the evidence span was in the five chunks and was deleted." .

sable:predictedBy a rdf:Property ;
    rdfs:label "temperature-0 run" .

sable:predictedLabel a rdf:Property ;
    rdfs:label "temperature-0 label" .

sable:quotesOk a rdf:Property ;
    rdfs:label "every quote was an exact substring" .

sable:sampledBy a rdf:Property ;
    rdfs:label "five-reply sample" .

sable:span a rdf:Property ;
    rdfs:label "annotator span" .

sable:statement a rdf:Property ;
    rdfs:label "claim text" .

sable:temperature a rdf:Property ;
    rdfs:label "decoding temperature" .

sable:tokenEntropy a rdf:Property ;
    rdfs:label "mean token entropy of the majority replies" ;
    rdfs:comment "Mean Shannon entropy, in bits, of every token in the completion. Each token uses its twenty most likely alternatives, and the remaining probability is one extra outcome. The token mean is averaged over the five replies that emitted the majority label." .

sable:tokenProbability a rdf:Property ;
    rdfs:label "probability of the first label token" ;
    rdfs:comment "Probability of the first label token in the one-round check." .

